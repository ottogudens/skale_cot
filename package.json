{
  "name": "skalio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.29.0",
      "ws": "8.18.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "prisma generate && vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.118",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@vinext/cloudflare": "^1.4.0",
    "ai": "^6.0.292",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "fflate": "^0.8.3",
    "jose": "^5.9.6",
    "next": "16.3.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "undici": "^6.29.0",
    "vinext": "^1.4.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.2",
    "postcss": "^8.5.33",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vite-css-modules": "^1.16.1"
  },
  "type": "module"
}
