# Supabase transaction pooler (port 6543). Used by the app in Vercel.
DATABASE_URL="postgresql://prisma.PROJECT_REF:PRISMA_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase session pooler (port 5432). Used only by Prisma CLI migrations.
DIRECT_URL="postgresql://prisma.PROJECT_REF:PRISMA_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Long random string (at least 32 characters)
AUTH_SECRET="replace-with-a-long-random-secret"
# First administrator. Used by `npm run db:seed`.
ADMIN_EMAIL="admin@tuempresa.cl"
ADMIN_PASSWORD="change-this-password"
# OpenAI API. Requerida para habilitar el asistente de terreno.
OPENAI_API_KEY=""
